### 7\. Implementation logic

The following pseudocode establishes the core engine without assuming unconfirmed gear speeds or rollover thresholds.

```python

from dataclasses import dataclass, field

EC_HOUR_SECONDS = 3600
CHECKPOINT_HOURS = 64.44
OUTER_PERIOD_HOURS = 386.64

LAYER_ALLOCATIONS = {
    "HI": 720.0,
    "ME": 360.0,
    "LO": 1080.0,
}

DECIMAL_SEQUENCE = (1.22, 0.44, 0.88)

@dataclass
class OrbitalState:
    elapsed_seconds: float = 0.0
    angles: dict = field(default_factory=lambda: {
        "HI": 0.0,
        "ME": 0.0,
        "LO": 0.0,
    })
    decimal_accumulator: float = 0.0
    cycle_number: int = 0
    records: list = field(default_factory=list)

def normalize_angle(angle):
    return angle % 360.0

def accumulate_decimal(state):
    for value in DECIMAL_SEQUENCE:
        state.decimal_accumulator += value

def rollover(value, boundary):
    if boundary <= 0:
        raise ValueError("Boundary must be positive")

    completed = int(value // boundary)
    remainder = value - completed * boundary
    return completed, remainder

def checkpoint(state):
    hours = state.elapsed_seconds / EC_HOUR_SECONDS

    return {
        "cycle": state.cycle_number,
        "elapsed_hours": hours,
        "elapsed_seconds": state.elapsed_seconds,
        "angles": {
            layer: normalize_angle(angle)
            for layer, angle in state.angles.items()
        },
        "accumulated_angles": dict(state.angles),
        "decimal_accumulation": state.decimal_accumulator,
    }

def advance(state, earth_seconds, angular_changes):
    if earth_seconds < 0:
        raise ValueError("Time cannot move backwards")

    state.elapsed_seconds += earth_seconds

    for layer, delta in angular_changes.items():
        if layer not in LAYER_ALLOCATIONS:
            raise ValueError(f"Unknown layer: {layer}")
        state.angles[layer] += delta

    return checkpoint(state)
```

This implementation deliberately separates elapsed time from angular movement. The angular changes must be supplied by a calibrated motion model; they should not be invented from the allocation values alone.

